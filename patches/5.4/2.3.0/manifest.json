  "upstream_changes": [
    {
      "commit": "6c931c0d922637c27a7f35e3d1cf55fb1c7305c4",
      "change": "Select existing fake status before original open; initialize a missing fake status only after successful original open.",
      "mapping": "Already implemented by BakaSU/kernel/feature/selinux_hide.c:552-575 my_sel_open_handle_status(); security/selinux/selinuxfs.c:221-231 retains the original host open.",
      "port_patch_changed": false
    },
    {
      "commit": "ca7093a1a26f7911987110c34a1352d74cfb1d09",
      "change": "Remove unused manual-GKI SELinux policy functions from the upstream KernelSU patch.",
      "mapping": "The 5.4 series does not import kernel_patches/KernelSU/10_enable_susfs_for_ksu.patch or the manual host entry points. Native BakaSU/kernel/feature/selinux_hide.c uses its own ksu_security_* helpers; its alternate SUSFS helper branch at lines 1843-2165 requires Linux >= 6.6.",
      "port_patch_changed": false
    }
  ]
